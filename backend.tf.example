# backend.tf.example
# Remote state in S3 with NATIVE locking (Terraform >= 1.11).
# DynamoDB is no longer required: `use_lockfile = true` makes S3 itself hold
# the lock via a conditional-write .tflock object next to the state file.
#
# Prereqs on the bucket:
#   * Versioning ENABLED (so a corrupted/locked state can be rolled back)
#   * Default encryption (SSE-KMS recommended) ENABLED
#   * Public access BLOCKED
#   * Bucket policy restricted to the EC2 instance role / tfexec principal

terraform {
  required_version = ">= 1.11.0"

  backend "s3" {
    bucket       = "myorg-tfstate-apne1"
    key          = "infra/prod/terraform.tfstate"
    region       = "ap-northeast-1"
    encrypt      = true
    use_lockfile = true # <-- S3-native lock; replaces dynamodb_table

    # Optional: customer-managed KMS key for the state object.
    # kms_key_id = "arn:aws:kms:ap-northeast-1:123456789012:key/abcd-..."
  }
}

# Minimum IAM permissions for the backend principal (least privilege):
#   s3:ListBucket               on arn:aws:s3:::myorg-tfstate-apne1
#   s3:GetObject/PutObject      on .../infra/prod/terraform.tfstate
#   s3:GetObject/PutObject/
#     DeleteObject              on .../infra/prod/terraform.tfstate.tflock
#   (+ kms:Encrypt/Decrypt/GenerateDataKey if SSE-KMS is used)
